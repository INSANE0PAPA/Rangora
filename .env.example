# =============================================================================
# RANGORA — Environment Configuration (.env.example)
# Copy this file to `.env` when running: `cp .env.example .env` (or `copy .env.example .env` on Windows)
# =============================================================================

# 1. Flask Session Secret Key & Port
FLASK_SECRET_KEY=rangora-production-or-local-secret-key-2026
PORT=5000

# 2. Primary Relational Database: Neon PostgreSQL
# Whenever DATABASE_URL is configured, Rangora connects directly to Neon PostgreSQL.
# If left blank, Rangora activates its obvious Local SQLite Fallback (`rangora_local.db`).
# Example Neon connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-your-project.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 3. Localhost Demonstration Mode (Viva Evaluation)
# When set to true, 1-click role switching (/api/auth/switch-role) is enabled for local
# presentation and evaluation. Set to false (or omit) for production to restrict role switching.
ENABLE_LOCAL_DEMO_MODE=true

# 4. Media Storage (Supabase Storage - Optional)
# If configured, event posters uploaded by organizers are stored in Supabase Storage and
# the public URL is persisted in Neon. If left blank, Rangora uses bundled local editorial photography.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=event-posters
GOOGLE_CLIENT_ID=
